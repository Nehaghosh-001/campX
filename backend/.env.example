# Django Secret Key (required in production)
SECRET_KEY=django-insecure-placement-cell-multi-college-platform-key-dev

# Set DEBUG to False in production
DEBUG=False

# Host domain names allowed (e.g. campx-backend.onrender.com or *)
ALLOWED_HOSTS=*

# Optional PostgreSQL Database URL from Render (if omitted, falls back to SQLite)
DATABASE_URL=

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True
